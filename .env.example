# Personal single-user server. Never put these values in public/ or a ZIP upload.
PORT=4174
HOST=127.0.0.1
APP_ORIGIN=http://localhost:4174
# Set a unique private login password, minimum 16 characters.
PERSONAL_PASSWORD=
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Register APP_ORIGIN/auth/google/callback as the exact redirect URI.
OPENAI_API_KEY=
# Choose a currently available Responses API model with structured-output support.
OPENAI_MODEL=
# SMS is optional. Use a provider-approved sending number and your verified personal number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
PERSONAL_PHONE=
# Set true only after configuring HTTPS hosting, your number, consent, and sender approval.
SMS_ENABLED=false
# Optional bearer secret for POST /api/jobs/run from your hosting scheduler.
CRON_SECRET=
